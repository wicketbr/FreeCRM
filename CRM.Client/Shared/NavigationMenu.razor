@implements IDisposable
@inject BlazorDataModel Model

@if (navigationMenuApp.Enabled) {
    <NavigationMenu_App Loading="Loading" />
} else {
    <header>
        <nav class="navbar fixed-top navbar-expand-lg navbar-expand-md border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" href="@(Helpers.BuildUrl())">
                    @{
                        string headerTitle = "<span>" + Helpers.Text("AppTitle").Replace("\"", "''") + "</span>";
                        // {{ModuleItemStart:Logo}}
                        if (!String.IsNullOrWhiteSpace(Helpers.LogoUrl) && Model.Tenant.TenantSettings.LogoIncludedOnNavbar) {
                            headerTitle = "<img src=\"" + Helpers.LogoUrl + "\" class=\"logo-navbar\" title=\"" + Helpers.Text("AppTitle") + "\" />";
                        }
                        // {{ModuleItemEnd:Logo}}
                        @((MarkupString)headerTitle)
                    }
                </a>
                <button id="menu-bar-toggler" class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navBarToggler" aria-controls="navbarSupportedContent"
                aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse" id="navBarToggler">
                    <ul class="navbar-nav me-auto">
                        @{
                            bool useNewMenus = false;
                            if (useNewMenus) {
                                // Started testing the new nested menus created by Daniel Pepka.
                                // However, for now the code is not running as this still has some testing to go.
                                var menuItems = new List<DataObjects.MenuItem>();

                                if (Model.LoggedIn) {
                                    menuItems.AddRange(Helpers.MenuItems.ToList());

                                    if (Helpers.MenuItemsAdmin.Any()) {
                                        menuItems.Add(new DataObjects.MenuItem { 
                                            Title = Helpers.Text("Admin"),
                                            Icon = "Admin",
                                            SortOrder = 999999,
                                            Children = Helpers.MenuItemsAdmin,
                                            PageNames = Helpers.MenuItemPageNames(Helpers.MenuItemsAdmin),
                                        });
                                    }
                                } else if (Model.Loaded) {
                                    menuItems.Add(new DataObjects.MenuItem { 
                                        Title = Helpers.Text("Login"),
                                        Icon = "Login",
                                        url = Helpers.BuildUrl("Login"),
                                        PageNames = new List<string> { "login" },
                                    });
                                }

                                foreach (var menuItem in menuItems) {
                                    var itemClass = "nav-link";
                                    var menuItemPageNames = Helpers.MenuItemPageNames(menuItem);

                                    if (menuItemPageNames.Contains(Model.View, StringComparer.CurrentCultureIgnoreCase)) {
                                        itemClass += " active";
                                    }

                                    if (menuItem.AppAdminOnly) {
                                        itemClass += " app-admin-only";
                                    }

                                    if (menuItem.Children != null && menuItem.Children.Any()) {
                                        <NavbarMenu
                                                AriaLabel="@menuItem.AriaLabel"
                                                Title="@menuItem.TooltipTitle"
                                                ToggleClass="@itemClass"
                                                MenuText="@menuItem.Title"
                                                Icon="@menuItem.Icon"
                                                ShowSearch="false"
                                                Value="menuItem.Children"/>
                                    } else {
                                        <li class="nav-item">
                                            @if (menuItem.OnClick != null) {
                                                string href = !String.IsNullOrWhiteSpace(menuItem.AriaLabel) ? menuItem.AriaLabel :
                                                    !String.IsNullOrWhiteSpace(menuItem.Title) ? menuItem.Title : Guid.NewGuid().ToString();

                                                <a class="@itemClass"
                                                        href="javascript:void('@href.Replace("'", "")');"
                                                        title="@menuItem.TooltipTitle"
                                                        aria-label="@menuItem.AriaLabel"
                                                        @onclick="@(() => menuItem.OnClick.DynamicInvoke())">
                                                    @if (!String.IsNullOrWhiteSpace(menuItem.Icon)) {
                                                        <Icon Name="@menuItem.Icon" />
                                                    }
                                                    <span class="icon-text">
                                                        @((MarkupString)menuItem.Title)
                                                    </span>
                                                </a>
                                            } else {
                                                <a class="@itemClass"
                                                        title="@menuItem.TooltipTitle"
                                                        aria-label="@menuItem.AriaLabel"
                                                        href="@menuItem.url">
                                                    @if (!String.IsNullOrWhiteSpace(menuItem.Icon)) {
                                                        <Icon Name="@menuItem.Icon" />
                                                    }
                                                    <span class="icon-text">
                                                        @((MarkupString)menuItem.Title)
                                                    </span>
                                                </a>
                                            }
                                        </li>
                                    }
                                }
                            } else {
                                if (Model.LoggedIn) {
                                    foreach (var item in Helpers.MenuItems) {
                                        var itemClass = "nav-link";

                                        if (item.PageNames.Contains(Model.View, StringComparer.CurrentCultureIgnoreCase)) {
                                            itemClass += " active";
                                        }

                                        if (item.AppAdminOnly) {
                                            itemClass += " app-admin-only";
                                        }

                                        if (item.Children != null && item.Children.Any()) {
                                            string currentUrl = Helpers.CurrentUrl.ToLower();
                                            // At this point only a single level of child items are supports.
                                            // So, any children added to child objects are ignored.
                                            // There is no built-in support in Bootstrap for nested submenus.
                                            // Once a good accessible solution is found that support will be added.
                                            <li class="nav-item dropdown">
                                                <a class="@itemClass dropdown-toggle"
                                                        data-bs-toggle="dropdown"
                                                        href="#"
                                                        role="button"
                                                        aria-expanded="false">
                                                    @if (!String.IsNullOrWhiteSpace(item.Icon)) {
                                                        <Icon Name="@item.Icon" />
                                                    }
                                                    <span class="icon-text">
                                                        @((MarkupString)item.Title)
                                                    </span>
                                                </a>
                                                <ul class="dropdown-menu">
                                                    @foreach (var child in item.Children.OrderBy(x => x.SortOrder).ThenBy(x => x.Title)) {
                                                        if (child.OnClick != null) {
                                                            string href = !String.IsNullOrWhiteSpace(child.AriaLabel) ? child.AriaLabel :
                                                                !String.IsNullOrWhiteSpace(child.Title) ? child.Title : Guid.NewGuid().ToString();
                                                            <li>
                                                                <a class="dropdown-item"
                                                                        href="javascript:void('@href.Replace("'", "")');"
                                                                        title="@child.TooltipTitle"
                                                                        aria-label="@child.AriaLabel"
                                                                        @onclick="@(() => child.OnClick.DynamicInvoke())">
                                                                    @if (!String.IsNullOrWhiteSpace(child.Icon)) {
                                                                        <Icon Name="@child.Icon" />
                                                                    }
                                                                    <span class="icon-text">
                                                                        @((MarkupString)child.Title)
                                                                    </span>
                                                                </a>
                                                            </li>
                                                        } else {
                                                            string dropDownItemClass = "dropdown-item";
                                                            if (child.url.ToLower() == currentUrl) {
                                                                dropDownItemClass += " active";
                                                            }

                                                            <li>
                                                                <a class="@dropDownItemClass"
                                                                        href="@child.url"
                                                                        title="@child.TooltipTitle"
                                                                        aria-label="@child.AriaLabel">
                                                                    @if (!String.IsNullOrWhiteSpace(child.Icon)) {
                                                                        <Icon Name="@child.Icon" />
                                                                    }
                                                                    <span class="icon-text">
                                                                        @((MarkupString)child.Title)
                                                                    </span>
                                                                </a>
                                                            </li>
                                                        }
                                                    }
                                                </ul>
                                            </li>
                                        } else {
                                            <li class="nav-item">
                                                @if (item.OnClick != null) {
                                                    string href = !String.IsNullOrWhiteSpace(item.AriaLabel) ? item.AriaLabel :
                                                        !String.IsNullOrWhiteSpace(item.Title) ? item.Title : Guid.NewGuid().ToString();

                                                    <a class="@itemClass"
                                                            href="javascript:void('@href.Replace("'", "")');"
                                                            title="@item.TooltipTitle"
                                                            aria-label="@item.AriaLabel"
                                                            @onclick="@(() => item.OnClick.DynamicInvoke())">
                                                        @if (!String.IsNullOrWhiteSpace(item.Icon)) {
                                                            <Icon Name="@item.Icon" />
                                                        }
                                                        <span class="icon-text">
                                                            @((MarkupString)item.Title)
                                                        </span>
                                                    </a>
                                                } else {
                                                    <a class="@itemClass"
                                                            title="@item.TooltipTitle"
                                                            aria-label="@item.AriaLabel"
                                                            href="@item.url">
                                                        @if (!String.IsNullOrWhiteSpace(item.Icon)) {
                                                            <Icon Name="@item.Icon" />
                                                        }
                                                        <span class="icon-text">
                                                            @((MarkupString)item.Title)
                                                        </span>
                                                    </a>
                                                }
                                            </li>
                                        }
                                    }

                                    @if (Helpers.MenuItemsAdmin.Any()) {
                                        <li class="nav-item dropdown">
                                            <a class="@(Helpers.AdminView ? "nav-link dropdown-toggle active" : "nav-link dropdown-toggle")" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                                <Language Tag="Admin" IncludeIcon="true" />
                                            </a>
                                            <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
                                                @foreach (var item in Helpers.MenuItemsAdmin) {
                                                    var itemClass = "dropdown-item";

                                                    if (item.PageNames.Contains(Model.View, StringComparer.CurrentCultureIgnoreCase)) {
                                                        itemClass += " active";
                                                    }

                                                    if (item.AppAdminOnly) {
                                                        itemClass += " app-admin-only";
                                                    }

                                                    <li>
                                                        @if (item.OnClick != null) {
                                                            string href = !String.IsNullOrWhiteSpace(item.AriaLabel) ? item.AriaLabel :
                                                                !String.IsNullOrWhiteSpace(item.Title) ? item.Title : Guid.NewGuid().ToString();

                                                            <a class="@itemClass"
                                                                    title="@item.TooltipTitle"
                                                                    aria-label="@item.AriaLabel"
                                                                    href="javascript:void('@href.Replace("'", "")');"
                                                                    @onclick="@(() => item.OnClick.DynamicInvoke())">
                                                                @if (!String.IsNullOrWhiteSpace(item.Icon)) {
                                                                    <Icon Name="@item.Icon" />
                                                                }
                                                                <span class="icon-text">
                                                                    @((MarkupString)item.Title)
                                                                </span>
                                                            </a>
                                                        } else {
                                                            <a class="@itemClass"
                                                                    title="@item.TooltipTitle"
                                                                    aria-label="@item.AriaLabel"
                                                                    href="@item.url">
                                                                @if (!String.IsNullOrWhiteSpace(item.Icon)) {
                                                                    <Icon Name="@item.Icon" />
                                                                }
                                                                <span class="icon-text">
                                                                    @((MarkupString)item.Title)
                                                                </span>
                                                            </a>
                                                        }
                                                    </li>
                                                }
                                            </ul>
                                        </li>
                                    }
                                } else if (Model.Loaded) {
                                    <li class="nav-item">
                                        <a class="nav-link @(Model.View == "login" ? "active" : "")" href="@Helpers.BuildUrl("Login")">
                                            <Language Tag="Login" IncludeIcon="true" />
                                        </a>
                                    </li>
                                }
                            }
                        }
                    </ul>
                    <form class="d-flex">
                        <ul class="navbar-nav me-auto">
                            @if (Model.HaveDeletedRecords) {
                                <li class="nav-item">
                                    <a class="nav-link deleted-records" role="button" href="@(Helpers.BuildUrl("Settings/DeletedRecords"))" title="@Helpers.Text("PendingDeletedRecords")">
                                        <Icon Name="DeletedRecords" />
                                    </a>
                                </li>
                            }

                            @if (String.IsNullOrWhiteSpace(Model.Tenant.TenantSettings.Theme)) {
                                <li class="nav-item dropdown" title="@Helpers.Text("Theme")">
                                    <a class="nav-link dropdown-toggle" href="javascript:void('@Helpers.Text("Theme").Replace("'", "")');" id="themeDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false" title="@Helpers.Text("SelectTheme")">
                                        @switch (Model.User.UserPreferences.Theme) {
                                            case "dark":
                                                <Icon Name="ThemeDark" />
                                                break;

                                            case "light":
                                                <Icon Name="ThemeLight" />
                                                break;

                                            case "auto":
                                            default:
                                                <Icon Name="ThemeAuto" />
                                                break;
                                        }
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="themeDropdown">
                                        @*
                                        <li>
                                            <a class="dropdown-item disabled" href="#">
                                                <Language Tag="Theme" IncludeIcon="true" />
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        *@
                                        <li>
                                            <a class="dropdown-item" href="javascript:void('@Helpers.Text("ThemeAuto").Replace("'", "")');" @onclick="@(() => Helpers.SetTheme("auto"))">
                                                <Language Tag="ThemeAuto" IncludeIcon="true" />
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" href="javascript:void('@Helpers.Text("ThemeLight").Replace("'", "")');" @onclick="@(() => Helpers.SetTheme("light"))">
                                                <Language Tag="ThemeLight" IncludeIcon="true" />
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" href="javascript:void('@Helpers.Text("ThemeDark").Replace("'", "")');" @onclick="@(() => Helpers.SetTheme("dark"))">
                                                <Language Tag="ThemeDark" IncludeIcon="true" />
                                            </a>
                                        </li>
                                    </ul>
                                </li>
                            }
                            <li class="nav-item">
                                <a class="nav-link" data-bs-toggle="offcanvas" href="#offcanvasUserMenu" role="button" aria-controls="offcanvasUserMenu" aria-labelledby="offcanvas-icon" title="@Helpers.Text("InfoMenu")">
                                    @if (Model.LoggedIn) {
                                        @if (!String.IsNullOrWhiteSpace(Helpers.UserAvatarUrl)) {
                                            <img class="user-menu-icon" src="@Helpers.UserAvatarUrl" alt="@Helpers.Text("Info")" aria-label="@Helpers.Text("Info")" id="offcanvas-icon" />
                                        } else {
                                            <Icon Name="User" Title="@Helpers.Text("Info")" Id="offcanvas-icon" />
                                        }
                                    } else {
                                        <Icon Name="Info" Title="@Helpers.Text("Info")" Id="offcanvas-icon" />
                                    }
                                </a>
                            </li>
                        </ul>
                    </form>
                </div>
            </div>
        </nav>
    </header>
}

@code {
    [Parameter] public bool Loading { get; set; }

    protected NavigationMenu_App navigationMenuApp = new NavigationMenu_App();

    public void Dispose()
    {
        Model.OnChange -= StateHasChanged;
    }

    protected override void OnInitialized()
    {
        Model.OnChange += StateHasChanged;
    }
}